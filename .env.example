# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is git-ignored on purpose - it must never be committed.
# Only the secrets are listed here; every tuning value (rate-limit windows,
# lockout thresholds, queue polling intervals, ...) has a sane default in
# application.yml and can be overridden the same way.

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/passwordlessdb
DB_USERNAME=passwordless
DB_PASSWORD=

# --- Redis (sessions, cache, rate limiting, email queue) --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT signing key (API / mobile clients) ---------------------------------
# Use a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Access token lifetime in seconds (default 3600 = 1 hour)
JWT_TTL_SECONDS=3600
# Refresh token lifetime in seconds (default 2592000 = 30 days)
JWT_REFRESH_TTL_SECONDS=2592000

# --- Monitoring scrape token ---------------------------------------------------
# Static Bearer token used by Prometheus to scrape /actuator/prometheus and
# /monitor/prometheus. Put the SAME value into the git-ignored file
# monitoring/monitoring-token (Prometheus reads it via credentials_file):
#
#     printf '%s' "$MONITORING_TOKEN" > monitoring/monitoring-token
#
MONITORING_TOKEN=

# --- OAuth2 providers (OPTIONAL) --------------------------------------------
# The app starts and every passwordless flow (magic link, OTP, TOTP) works
# WITHOUT these - they only enable the "Sign in with Google/GitHub" buttons
# and Google One Tap. To use them, create your own OAuth apps and paste the
# four values below; the dev profile falls back to inert placeholders.
#
# NOTE: Spring does not read this file by itself. Export it into your shell
# before `./mvnw spring-boot:run`:
#
#     set -a; source .env; set +a
#
# (docker-compose picks .env up automatically.)
#
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Mail (magic link, OTP, security alerts) --------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# --- SMS (Twilio) -----------------------------------------------------------
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- reCAPTCHA --------------------------------------------------------------
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=

# --- GeoIP (MaxMind GeoLite2 database) --------------------------------------
# On first run the app downloads GeoLite2-City.mmdb (~60 MB) into ./data
# automatically and logs its progress. Set GEOIP_AUTO_DOWNLOAD=false to opt
# out, or point GEOIP_DATABASE_PATH at a copy you downloaded from MaxMind
# yourself (GeoLite2 is distributed under MaxMind's own license).
GEOIP_ENABLED=true
GEOIP_DATABASE_PATH=./data/GeoLite2-City.mmdb
GEOIP_AUTO_DOWNLOAD=true
# GEOIP_DOWNLOAD_URL=https://github.com/P3TERX/GeoLite.mmdb/releases/latest/download/GeoLite2-City.mmdb

# --- Local infrastructure UIs (docker-compose) ------------------------------
PGADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
