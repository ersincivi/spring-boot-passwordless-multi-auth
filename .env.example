# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is git-ignored on purpose - it must never be committed.
# Only the secrets are listed here; every tuning value (rate-limit windows,
# lockout thresholds, queue polling intervals, ...) has a sane default in
# application.yml and can be overridden the same way.

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/passwordlessdb
DB_USERNAME=passwordless
DB_PASSWORD=

# --- Redis (sessions, cache, rate limiting, email queue) --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT signing key (API / mobile clients) ---------------------------------
# Use a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Access token lifetime in seconds (default 3600 = 1 hour)
JWT_TTL_SECONDS=3600
# Refresh token lifetime in seconds (default 2592000 = 30 days)
JWT_REFRESH_TTL_SECONDS=2592000

# --- Monitoring scrape token ---------------------------------------------------
# Static Bearer token used by Prometheus to scrape /actuator/prometheus and
# /monitor/prometheus. Must match the credentials in monitoring/prometheus.yml.
MONITORING_TOKEN=

# --- OAuth2 providers -------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Mail (magic link, OTP, security alerts) --------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# --- SMS (Twilio) -----------------------------------------------------------
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- reCAPTCHA --------------------------------------------------------------
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=

# --- GeoIP (MaxMind GeoLite2 database) --------------------------------------
GEOIP_ENABLED=true
GEOIP_DATABASE_PATH=./data/GeoLite2-City.mmdb

# --- Local infrastructure UIs (docker-compose) ------------------------------
PGADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
