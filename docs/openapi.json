    "/api/auth/verify": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verify MagicLink",
        "description": "Verify a MagicLink token from the email link. This endpoint runs in the browser, so it responds with a 302 redirect to the mobile app scheme (app.mobile.callback-url, default `passwordless://auth/callback`) instead of JSON. On success the redirect carries a one-time exchange code (`?code=...`) which the app trades for a token pair via `POST /api/auth/exchange`. If TOTP is enabled, the redirect carries `?status=totp_required&username=...&email=...` and the app must call `POST /api/auth/totp/verify`. Failures redirect with `?status=error&reason=...`.",
        "operationId": "verifyApiMagicLink",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "description": "MagicLink token from email",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the app callback. Success: `?code={oneTimeCode}`; TOTP: `?status=totp_required&username=...&email=...`; Error: `?status=error&reason=token_missing|token_invalid|user_not_found|account_disabled|account_locked|verification_failed`"
          }
        }
      }
    },
    "/api/auth/exchange": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Exchange code for tokens",
        "description": "Trade the one-time exchange code received via the app-scheme redirect for a JWT access token + refresh token pair. The code is single use and expires after 60 seconds.",
        "operationId": "exchangeCode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "One-time exchange code from the app-scheme redirect"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token pair returned: {token, expiresAt, refreshToken, refreshTokenExpiresAt}"
          },
          "400": {
            "description": "Missing exchange code"
          },
          "401": {
            "description": "Invalid, expired or already used exchange code"
          },
          "403": {
            "description": "Account disabled or locked"
          }
        },
        "security": []
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Refresh access token",
        "description": "Exchange a valid refresh token for a new access token and a new refresh token. The presented refresh token is invalidated (single-use rotation).",
        "operationId": "refreshAccessToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refreshToken"
                ],
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New token pair issued: {token, expiresAt, refreshToken, refreshTokenExpiresAt}"
          },
          "400": {
            "description": "Missing refresh token"
          },
          "401": {
            "description": "Refresh token invalid, expired or already used"
          }
        },
        "security": []
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Logout",
        "description": "Revoke the current access token (from the Authorization header) and optionally the refresh token passed in the request body.",
        "operationId": "logout",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Tokens revoked"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Current user",
        "description": "Return profile, roles and MFA status of the authenticated user.",
        "operationId": "currentUser",
        "responses": {
          "200": {
            "description": "Current user information: {username, email, name, profileImage, mfaEnabled, roles}"
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
